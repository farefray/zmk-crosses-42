// ============================================================================
// Crosses 42 — ZMK Keymap — STAGE 9 (A3 + B1: drop mod-morphs, ;: at pos 35)
//
// Stages 1-8: hardware-verified history (see STAGEn_NOTES.md per stage).
//
// Stage 9 features (this stage):
//   • BASE punctuation rework (audit option A3 + B1):
//     - pos 23: SQT plain (', Shift = ")           — was mcs (',;')
//     - pos 32: COMMA plain (,, Shift = <)         — was SQT
//     - pos 33: DOT plain (., Shift = >)           — was mdc ('.:')
//     - pos 35: mscl mod-morph (; tap, : Shift)    — was BSLH ('\|')
//     Rationale: pos 32/33 return to QWERTY-like positions (matches Max's
//     dominant muscle memory — Stage 8 swap chased the wrong memory). `;`
//     and `:` move off Shift+pos-23 and Shift+pos-33 onto a dedicated key
//     at outer-pinky bottom. `\` is rare in daily typing → relegated to SYM.
//   • Behaviors block: mcs and mdc removed (no longer used). mscl added.
//     (Label is `mscl` not `msc` — `msc` collides with upstream ZMK
//     mouse_scroll behavior used on MOUSE layer.)
//   • SYM realign (column-alignment rule mostly preserved):
//       pos 23 SYM = '"'   (matches SQT Shift at pos 23 on BASE)
//       pos 32 SYM = '<'   (matches COMMA Shift at pos 32 on BASE)
//       pos 33 SYM = '.'   (BASE-TAP mirror, NOT BASE-shift — exception to
//                          the rule, for typing `1.5.0` from SYM/Numword)
//       pos 34 SYM = '?'   (unchanged — matches FSLH Shift)
//       pos 35 SYM = ':'   (matches mscl Shift at pos 35 on BASE)
//     `\` relocated to SYM pos 29 (joins the left-side bracket cluster as
//     the escape character). SYM pos 30 = '>' (relocated from pos 33 to
//     keep `>` directly tappable on SYM without a Shift chord).
//   • `<` reachable: SYM pos 32 direct, or Shift+pos-32 on BASE.
//   • `>` reachable: SYM pos 30 direct, or Shift+pos-33 on BASE/SYM.
//   • `.` reachable: BASE pos 33 direct, or SYM pos 33 direct (same column).
//   • UKR Ґ path shifts: was Shift+SYM+pos-35, now Shift+SYM+pos-29
//     (where \ lives on SYM).
//
// All Stage 8 mechanics retained:
//   • combo_ctrl_v on pos 14+29 (S+V) — Ctrl+V via combo
//   • NAV pos 27/28/29 = Ctrl+F / Ctrl+S / Ctrl+Y
//   • Brackets on left ([ ] { }) at pos 25-28 (inward rolls)
//   • ( ) on right (pos 21/22), = at right-index home (pos 31)
//   • Number-row shift partners 8→*, 9→(, 0→) at pos 20-22
//
// All Stage 7 mechanics retained:
//   • sht (Space/Shift balanced, 200/0/75)
//   • Numword on td_sym double-tap, momentary on single-hold
//   • Caps Word combo (pos 36+37), Bootloader combo (pos 0+11 on NAV)
//   • Mouseless combos: D+V → ScrollLock (overlay), K+H → Pause (free)
//   • Alt-Tab swapper (tri-state) on NAV pos 17
//   • Dedicated LCTRL at pos 24 (still the long-tail Ctrl key)
//   • All bracket characters live on SYM only (no BASE TD brackets)
//
// Current BASE HRM scope:
//   • Win/Alt only: A=LGUI, R=LALT, I=RALT, O=RGUI
//   • S/T/N/E are plain keys; Ctrl and Shift use dedicated alternatives
//
// KeyPeek integration (Stage 6+):
//   See KEYPEEK_SETUP.md. After this stage's rebuild, refresh the behavior
//   IDs in keypeek-crosses42/src/zmk_keycode_labels/crosses42.rs — they
//   change on every behaviors-block edit. Stage 9 removes mcs and mdc
//   labels and adds an mscl label. Stage 8 patched the fork's
//   keycode_label.rs to render single-glyph (vs QMK keycap-style two-line)
//   labels for LBKT/RBKT/BSLH/MINUS/EQUAL/COMMA/PERIOD/SLASH/SEMI/SQT/GRAVE.
//
// UKR layer notes:
//   • Thumbs are &trans — fall through to BASE (SYM/NAV thumbs still work)
//   • Ґ (rare 33rd letter): hold SYM thumb → SYM layer → BSLH position
//     (now pos 29 SYM, was pos 35 pre-Stage-9), while holding any Shift
//     source. UKR home-row Y/J have no HRM, so Shift comes from BASE
//     SPC⇧ thumb (pos 37 &trans → BASE sht).
//   • Windows IME must be switched manually (Win+Space) before entering L4
//
// Game layer notes:
//   • HRM positions use plain &kp — no hold-tap timing at all
//   • &none on right-side unused positions blocks BASE HRM fallthrough
//   • EXIT on three right-side keys: top-right outer, bottom-right outer,
//     right inner thumb
//
// Hardware-verified UX checkpoint (2026-09-01):
//   • Right-ball Auto Mouse with conventional click/wheel controls; Grid Jump
//     removed because it was not useful in daily practice.
//   • Six-count/80 ms motion gate plus 500 ms prior-idle guard prevents
//     key-strike vibration from activating Mouse.
//   • BASE HRMs reduced to Win/Alt only; S/T/N/E remain plain keys.
// Deferred: extend the Ctrl+V combo pattern only if direct evidence supports
//   it; consider tighter timing only for the four retained Win/Alt HRMs.
// ============================================================================

#include <behaviors.dtsi>
#include <behaviors/num_word.dtsi>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/reset.h>

#define BASE  0
#define SYM   1
#define NAV   2
#define MOUSE 3
#define UKR   4
#define GAME  5

#define LEFT_HAND_KEYS  \
        0  1  2  3  4  5  \
        12 13 14 15 16 17 \
        24 25 26 27 28 29 \
        36 37 38

#define RIGHT_HAND_KEYS \
        6  7  8  9  10 11 \
        18 19 20 21 22 23 \
        30 31 32 33 34 35 \
        39 40 41

/ {
    auto_mouse_layer: auto_mouse_layer {
        compatible = "zmk,input-processor-temp-layer";
        #input-processor-cells = <2>;
        // Do not let desk/ball vibration from typing raise Mouse. Pointer
        // motion still reaches the host during this guard; only the automatic
        // layer activation waits until the keyboard has been idle for 500 ms.
        require-prior-idle-ms = <500>;
        excluded-positions = <12 13 14 15 16 25 26 27 28 36 37 38>;
    };

    auto_mouse_gate: auto_mouse_gate {
        compatible = "zmk,input-processor-motion-gated-temp-layer";
        #input-processor-cells = <2>;
        processor = <&auto_mouse_layer>;
        // Hard key strikes can mechanically nudge the PMW3610 by 1-2 counts.
        // Require a small intentional movement before raising Mouse; motion
        // itself still reaches the host without being delayed or discarded.
        activation-threshold = <6>;
        activation-window-ms = <80>;
    };

    chosen {
        zmk,physical-layout = &gggw_crosses_42_layout;
    };

    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <260>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <200>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <RIGHT_HAND_KEYS>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <260>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <200>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <LEFT_HAND_KEYS>;
            hold-trigger-on-release;
        };

        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
        };

        // Space/Shift: balanced flavor so rolling through Space into the
        // next letter produces Space (not Shift). Intentional Shift still
        // works: hold Space → press+release letter → release Space.
        // A short require-prior-idle-ms still protects fast typing rolls while
        // allowing Shift soon after another key. quick-tap-ms is disabled so
        // a rapid Space → Shift reuse is not forced to resolve as Space.
        sht: space_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <75>;
            bindings = <&kp>, <&kp>;
        };

        bspc_del: bspc_del {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BSPC>, <&kp DEL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // Stage 9 mod-morph: ;: at outer-pinky bottom (pos 35 BASE).
        // mscl: tap = `;`, Shift+tap = `:`
        // Label is `mscl` (not `msc`) — `msc` is taken by upstream ZMK's
        // mouse_scroll behavior, which is used on the MOUSE layer below.
        // Replaces Stage 6's mcs/mdc mod-morphs which were removed when
        // BASE pos 23/32/33 became plain &kp (audit option A3). `;` and `:`
        // now have a dedicated key instead of being Shift-shadows of `,`/`.`.
        mscl: semi_colon {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SEMI>, <&kp COLON>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // Slash unchanged on BASE — Shift+/ produces `?` via the OS (no
        // mod-morph needed). pos 23 BASE = plain SQT (Shift = "). pos 32
        // BASE = plain COMMA (Shift = <). pos 33 BASE = plain DOT (Shift = >).

        // TD brackets removed in Stage 7 — LCTRL at pos 24, no more on BASE.
        // All bracket chars remain accessible on SYM layer.

        // SYM tap-dance: 1× hold = momentary SYM, 2× tap = Numword.
        // Numword (zmk-auto-layer) auto-exits when a non-number key is pressed.
        // For sustained symbol editing, hold SYM instead of double-tapping.
        td_sym: td_sym {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo SYM>, <&num_word SYM>;
        };

        // Alt-Tab swapper: first tap holds Alt + sends Tab, subsequent taps
        // send Tab. Alt releases when any non-ignored key is pressed or when
        // the NAV layer deactivates. Arrow keys are ignored so you can
        // navigate the Windows task switcher.
        swapper: swapper {
            compatible = "zmk,behavior-tri-state";
            #binding-cells = <0>;
            bindings = <&kt LALT>, <&kp TAB>, <&kt LALT>;
            ignored-key-positions = <20 31 32 33>;
            timeout-ms = <5000>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Caps Word: press BSPC + SPC thumbs simultaneously (pos 36+37).
        // Natural two-thumb gesture, no layer switch needed.
        // Activates Caps Word for Go constants like HTTP_STATUS_OK.
        combo_caps_word {
            timeout-ms = <50>;
            key-positions = <36 37>;
            bindings = <&caps_word>;
            layers = <BASE>;
        };

        // Bootloader: press both outer top corners (pos 0+11) on NAV layer.
        // Intentionally hard to trigger — requires holding NAV + pressing
        // two far-apart keys simultaneously. Replaces the old single-key
        // bootloader at NAV pos 35.
        combo_bootloader {
            timeout-ms = <50>;
            key-positions = <0 11>;
            bindings = <&bootloader>;
            layers = <NAV>;
        };

        // Mouseless overlay: D+V (pos 28+29) → ScrollLock.
        // Configure Mouseless "show overlay" to ScrollLock in its settings.
        // Left bottom row, adjacent inner keys — natural two-finger press.
        combo_mouseless_overlay {
            timeout-ms = <40>;
            key-positions = <28 29>;
            bindings = <&kp SLCK>;
            layers = <BASE>;
            require-prior-idle-ms = <200>;
        };

        // Mouseless free mode: K+H (pos 30+31) → Pause/Break.
        // Configure Mouseless "toggle free mode" to Pause in its settings.
        // Right bottom row, adjacent inner keys — mirrors the left combo.
        combo_mouseless_free {
            timeout-ms = <40>;
            key-positions = <30 31>;
            bindings = <&kp PAUSE_BREAK>;
            layers = <BASE>;
            require-prior-idle-ms = <200>;
        };

        // Stage 8: Ctrl+V via S+V combo (pos 14+29).
        // Kept as a direct shortcut even though S is now a plain key:
        // 40ms simultaneous press → Ctrl+V, no timing/positional contest.
        // require-prior-idle-ms=150 prevents accidental fire during fast
        // typing — English bigram "sv" is essentially nonexistent anyway.
        // Pattern can extend to S+X / S+C / S+D / S+A in Stage 9 if this
        // proves reliable.
        combo_ctrl_v {
            timeout-ms = <40>;
            key-positions = <14 29>;
            bindings = <&kp LC(V)>;
            layers = <BASE>;
            require-prior-idle-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ── L0 Base ──────────────────────────────────────────────────────────
        // ESC/~ at top-left (pos 0). TAB at pos 12 (home row outer left).
        // LCTRL at pos 24 — dedicated Ctrl for same-hand shortcuts:
        //   Ctrl+Z (25), Ctrl+X (26), Ctrl+C (27), Ctrl+D (28), Ctrl+V (29),
        //   Ctrl+S (14), Ctrl+A (13), Ctrl+W (2). Fixes HRM gap where S IS Ctrl.
        // Stage 9 punctuation (post mcs/mdc removal):
        //   pos 23 = SQT plain    (',  Shift = ")
        //   pos 32 = COMMA plain  (,,  Shift = <)
        //   pos 33 = DOT plain    (.,  Shift = >)
        //   pos 34 = FSLH plain   (/,  Shift = ?)
        //   pos 35 = mscl         (;,  Shift = :)   — new ;: mod-morph
        // `\` no longer on BASE — reachable on SYM pos 29 only. UKR Ґ uses
        // that same SYM position now (was pos 35 in Stage 8).
        // Right outer thumb (pos 41) is &mo MOUSE for trackball clicks.
        // Combos: S+V = Ctrl+V (Stage 8), D+V = Mouseless overlay,
        //         K+H = Mouseless free mode, BSPC+SPC = Caps Word.
        base_layer {
            display-name = "Base";
            bindings = <
    &ht TILDE ESC  &kp Q          &kp W          &kp F          &kp P          &kp B
                                                                                       &kp J          &kp L          &kp U          &kp Y          &kp EQUAL      &kp MINUS
    &kp TAB        &hml LGUI A    &hml LALT R    &kp S          &kp T          &kp G
                                                                                       &kp M          &kp N          &kp E          &hmr RALT I    &hmr RGUI O    &kp SQT
    &kp LCTRL      &kp Z          &kp X          &kp C          &kp D          &kp V
                                                                                       &kp K          &kp H          &kp COMMA      &kp DOT        &kp FSLH       &mscl
                                                 &bspc_del      &sht LSHFT SPACE &td_sym
                                                                                       &mo NAV        &mt LCTRL RET  &mo MOUSE
            >;
        };

        // ── L1 Sym ───────────────────────────────────────────────────────────
        // Access: hold ▽SYM (left inner thumb) = momentary
        //         2× tap ▽SYM = Numword (auto-exits on non-number key)
        // Right inner thumb (pos 38) returns to BASE (&to BASE).
        //
        // Stage 9 realign (column rule preserved against new BASE):
        //   • Brackets clustered on left row 3 ([ ] { } at pos 25-28).
        //     Inward rolls for [] and {}.
        //   • `\` at pos 29 — joins the left bracket cluster as the escape
        //     char. Also the UKR Ґ key (Shift+pos-29 → Windows IME maps to Ґ).
        //   • pos 30 = `>` — relocated here so `.` can take pos 33 (see below).
        //   • ( ) on right (pos 21/22) — matches shift+9/0 muscle memory.
        //   • = at right-index home (pos 31) — anchor for ==/!=/=>.
        //   • Column-aligned with BASE: pos 23='"' 32='<' 34='?' 35=':'.
        //   • pos 33 = `.` (BASE-tap mirror, NOT BASE-shift). Lets you type
        //     version numbers like `1.5.0` from SYM/Numword without exiting.
        //     `.` is in num_word's continue-list, so Numword stays active.
        //     `>` still reachable two ways: tap pos 30, or Shift+pos-33
        //     (Shift+. = > via OS layer).
        //   • Number-row shifts standard: 8→*, 9→(, 0→) at pos 20-22.
        //   • + and - not duplicated on SYM (use shift+= and pos 11 on BASE).
        //   • / not duplicated (use pos 34 on BASE; SYM pos 34 = '?').
        //   • `<` reachable two ways: SYM pos 32 (direct) or Shift on BASE
        //     pos 32. `>` reachable two ways: SYM pos 30 (direct) or Shift
        //     on SYM pos 33 / BASE pos 33.
        sym_layer {
            display-name = "Sym";
            bindings = <
    &kp GRAVE      &kp N1         &kp N2         &kp N3         &kp N4         &kp N5
                                                                                       &kp N6         &kp N7         &kp N8         &kp N9         &kp N0         &kp BSPC
    &kp TILDE      &kp EXCL       &kp AT         &kp HASH       &kp DLLR       &kp PRCNT
                                                                                       &kp CARET      &kp AMPS       &kp STAR       &kp LPAR       &kp RPAR       &kp DQT
    &kp UNDER      &kp LBKT       &kp RBKT       &kp LBRC       &kp RBRC       &kp BSLH
                                                                                       &kp GT         &kp EQUAL      &kp LT         &kp DOT        &kp QMARK      &kp COLON
                                                 &trans         &trans         &to BASE
                                                                                       &trans         &trans         &trans
            >;
        };

        // ── L2 Nav + Fn ──────────────────────────────────────────────────────
        // Left home row: clipboard (Undo/Cut/Copy/Paste) — one-hand editing
        // Left bottom row pos 27-29 (Stage 8): Find / Save / Redo. Pairs with
        //   the clipboard cluster above so all common editor shortcuts are
        //   under one NAV hold.
        // pos 12: Caps Word
        // pos 17: Alt-Tab swapper (tri-state)
        // pos 24-26: UKR / Game / Mouse layer toggles
        // Left thumbs: MB1/MB2/MB3 for trackball clicks while holding NAV
        // Bootloader: combo (pos 0+11), not a single key
        nav_layer {
            display-name = "Nav";
            bindings = <
    &kp F12        &kp F1         &kp F2         &kp F3         &kp F4         &kp F5
                                                                                       &kp F6         &kp F7         &kp F8         &kp F9         &kp F10        &kp F11
    &caps_word     &kp LC(Z)      &kp LC(X)      &kp LC(C)      &kp LC(V)      &swapper
                                                                                       &kp PG_UP      &kp HOME       &kp UP         &kp END        &kp INS        &kp PSCRN
    &tog UKR       &tog GAME      &tog MOUSE     &kp LC(F)      &kp LC(S)      &kp LC(Y)
                                                                                       &kp PG_DN      &kp LEFT       &kp DOWN       &kp RIGHT      &kp C_MUTE     &kp C_PP
                                                 &mkp MB1       &mkp MB2       &mkp MB3
                                                                                       &trans         &kp C_VOL_UP   &kp C_VOL_DN
            >;
        };

        // ── L3 Auto Mouse ─────────────────────────────────────────────────────
        // Right-ball motion activates this layer for 1000 ms. Continued motion
        // refreshes the timeout. A 500 ms prior-idle guard prevents typing
        // vibration or incidental ball brushes from raising Mouse.
        //
        // Left home row: MB4 / MB1 / MB2 / MB3 / MB5.
        // Left bottom row: discrete wheel up / down / left / right.
        // Left thumbs: MB2 / MB1 / MB3, with primary click at the center
        // Space position for the easiest click-drag hold.
        //
        // Grid Jump is intentionally removed. Quiet left positions use &none
        // so they cannot leak Base characters while the temporary layer is
        // visibly active in KeyPeek. Mouse actions are excluded from the
        // processor's press-to-dismiss behavior.
        //
        // Manual fallback remains: Base pos 41 holds Mouse; Nav pos 26 toggles
        // Mouse; pos 11 exits the toggle. The existing right-side mouse actions
        // remain as manual alternatives to the automatic workflow.
        mouse_layer {
            display-name = "Mouse";
            bindings = <
    &none          &none          &none          &none          &none          &none
                                                                                       &trans         &trans         &trans         &trans         &trans         &tog MOUSE
    &mkp MB4       &mkp MB1       &mkp MB2       &mkp MB3       &mkp MB5       &none
                                                                                       &mkp MB4       &mkp MB1       &mkp MB2       &mkp MB3       &mkp MB5       &trans
    &none          &msc SCRL_UP   &msc SCRL_DOWN &msc SCRL_LEFT &msc SCRL_RIGHT &none
                                                                                       &trans         &msc SCRL_UP   &msc SCRL_DOWN &msc SCRL_LEFT &msc SCRL_RIGHT &trans
                                                 &mkp MB2       &mkp MB1       &mkp MB3
                                                                                       &mkp MB1       &mkp MB3       &trans
            >;
        };

        // ── L4 UKR ───────────────────────────────────────────────────────────
        // QWERTY keycodes for Windows Ukrainian IME. No HRM — straight &kp only.
        // Thumbs are &trans — fall through to BASE (SYM + NAV thumbs still work).
        // pos 24 (bottom-left outer) = &trans — falls through to BASE LCTRL,
        //   so Ctrl+C/V/Z work while typing Ukrainian.
        // pos 35 (bottom-right outer) = Ї (&kp RBKT). Overrides BASE backslash.
        // EXIT (pos 0): &tog UKR.
        //
        // Ukrainian letter mapping (Windows Ukrainian QWERTY IME):
        //   Q=Й W=Ц E=У R=К T=Е  Y=Н U=Г I=Ш O=Щ P=З  [=Х ]=Ї
        //   A=Ф S=І D=В F=А G=П  H=Р J=О K=Л L=Д ;=Ж '=Є
        //   Z=Я X=Ч C=С V=М B=И  N=Т M=Ь ,=Б .=Ю /=.
        //   Ґ (rare): Shift+BSLH via SYM layer (SYM thumb still active via &trans)
        ukr_layer {
            display-name = "UKR";
            bindings = <
    &tog UKR       &kp Q          &kp W          &kp E          &kp R          &kp T
                                                                                       &kp Y          &kp U          &kp I          &kp O          &kp P          &kp BSPC
    &kp LBKT       &kp A          &kp S          &kp D          &kp F          &kp G
                                                                                       &kp H          &kp J          &kp K          &kp L          &kp SEMI       &kp SQT
    &trans         &kp Z          &kp X          &kp C          &kp V          &kp B
                                                                                       &kp N          &kp M          &kp COMMA      &kp DOT        &kp FSLH       &kp RBKT
                                                 &trans         &trans         &trans
                                                                                       &trans         &trans         &trans
            >;
        };

        // ── L5 Game ──────────────────────────────────────────────────────────
        // Pure QWERTY for gaming — all &kp, no HRM, no timing behaviors.
        // &none on right-side unused positions blocks BASE HRM fallthrough.
        // EXIT on three right-side keys (top-right outer, bottom-right outer,
        // right inner thumb): &tog GAME.
        game_layer {
            display-name = "Game";
            bindings = <
    &kp ESC        &kp N1         &kp N2         &kp N3         &kp N4         &kp N5
                                                                                       &kp N6         &kp N7         &kp N8         &kp N9         &kp N0         &tog GAME
    &kp TAB        &kp Q          &kp W          &kp E          &kp R          &kp T
                                                                                       &kp Y          &kp U          &kp I          &kp O          &kp P          &none
    &kp LSHFT      &kp A          &kp S          &kp D          &kp F          &kp G
                                                                                       &kp H          &kp J          &kp K          &kp L          &kp SEMI       &tog GAME
                                                 &kp LCTRL      &kp SPACE      &kp LALT
                                                                                       &none          &tog GAME      &none
            >;
        };
    };
};

// The right PMW3610 is attached to the central listener. Temporary-layer
// processing must run before report-rate limiting so every real motion report
// can count toward activation or refresh Mouse even if the HID report itself
// is coalesced. Six cumulative X/Y counts within 80 ms rejects key-strike
// vibration while keeping intentional trackball movement effectively instant.
&trackball_central_listener {
    input-processors = <&auto_mouse_gate MOUSE 1000>, <&zip_ble_report_rate_limit>;
};
